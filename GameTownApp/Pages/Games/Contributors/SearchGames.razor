@page "/searchmetadata"
@attribute [Authorize(Roles = "Admin,Contributor")]

@* Thin wrapper now: the picker and the card are shared with AddGame. *@

<h3 class="mb-4">Search Games</h3>

<RawgGamePicker SelectedGameChanged="game => SelectedGame = game" />

<RawgGameCard Game="SelectedGame" ShowScreenshots="true" />

@code {
    private RawgGameContract? SelectedGame;
}

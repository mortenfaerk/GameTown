@page "/searchmetadata"
@attribute [Authorize(Roles = "Admin,Contributor")]

@* Thin wrapper now: the picker and the card are shared with AddGame. *@

@* Named for the sidebar link that leads here — one name for one place. *@
<h3 class="mb-1">Browse metadata</h3>
<p class="gt-muted mb-4">Look a game up in the provider's catalogue. Nothing here is saved.</p>

<MetadataPicker Selected="SelectedGame" SelectedChanged="game => SelectedGame = game" />

<div class="mt-4">
    <MetadataCard Game="SelectedGame" ShowScreenshots="true" />
</div>

@code {
    private GameMetadataContract? SelectedGame;
}

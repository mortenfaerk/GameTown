@page "/addgame"
@attribute [Authorize(Roles = "Admin,Contributor")]
@implements IAsyncDisposable
@inject GamesService GamesService
@inject UploadService UploadService

<PageTitle>Add game</PageTitle>

<h1>Add a game</h1>
<p class="gt-muted">Upload a game archive and, optionally, attach RAWG metadata to it.</p>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger alert-dismissible">
        @Error
        <button type="button" class="btn-close" @onclick="() => Error = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Notice))
{
    <div class="alert alert-success">
        @Notice
        @if (AddedGameId is not null)
        {
            @* Cover art is set on the detail page, and RAWG has no box art — so for most games this
               link is the next thing that needs doing. *@
            <a class="ms-2" href="@($"/game/{AddedGameId}")">Open it to add cover art</a>
        }
    </div>
}

<EditForm Model="Request" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="game-title">Title</label>
        <InputText id="game-title" class="form-control" @bind-Value="Request.Title" disabled="@Busy" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="game-howto">How to play / install</label>
        <InputTextArea id="game-howto" class="form-control" rows="4" @bind-Value="Request.HowTo" disabled="@Busy" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="game-file">Game archive</label>
        @* @ref so the raw <input> can be handed to the JS uploader. *@
        <InputFile id="game-file" @ref="fileInput" class="form-control"
                   OnChange="OnFileSelected" accept="@AcceptAttribute" disabled="@Busy" />
        @if (SelectedFile is not null)
        {
            <div class="form-text">@SelectedFile.Name — @FormatSize(SelectedFile.Size)</div>
        }
        <div class="form-text">
            Allowed formats: @string.Join(", ", AllowedExtensions).
            @if (MaxUploadBytes > 0)
            {
                @($" Maximum size: {Limits!.MaxUploadSizeMb} MB.")
            }
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">RAWG metadata (optional)</label>
        <RawgGamePicker SelectedGameChanged="OnRawgGameSelected"
                        Placeholder="Search RAWG for this game…" />
        @if (SelectedRawgGame is not null)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-success">Attached: @SelectedRawgGame.Name (id @SelectedRawgGame.Id)</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearRawgGame" disabled="@Busy">Clear</button>
            </div>
        }
    </div>

    <RawgGameCard Game="SelectedRawgGame" />

    @if (Busy)
    {
        <div class="upload mb-3">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <span class="gt-data">@StatusText</span>
                @* Hidden once the body is sent. Aborting the XHR at that point does not stop the
                   server — it only throws away the answer, leaving the contributor unsure whether
                   the game was added and likely to upload it a second time. *@
                @if (!Processing)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="Cancel">Cancel</button>
                }
            </div>

            <div class="progress" role="progressbar" aria-label="@(Processing ? "Server processing" : "Upload progress")"
                 aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar @(Indeterminate ? "progress-bar-striped progress-bar-animated" : "")"
                     style="width: @(Indeterminate ? 100 : Percent)%"></div>
            </div>

            @if (Processing)
            {
                @* There is no real percentage to show here. The server writes the archive as it
                   arrives, so by this point the remaining work is the database row plus any RAWG
                   artwork download — neither of which reports progress. An honest indeterminate bar
                   with an elapsed clock beats a fake percentage. *@
                <p class="gt-data mt-1 mb-0">
                    Transfer complete — the server is saving
                    @(SelectedRawgGame is null ? "the game" : "the game and fetching artwork from RAWG").
                    @FormatElapsed(ProcessingSeconds) elapsed.
                </p>
                @if (ProcessingSeconds >= 20)
                {
                    <p class="gt-muted mb-0">Leave this page open — closing it will not cancel it, but you will not see the result.</p>
                }
            }
        </div>
    }

    <button type="submit" class="btn btn-primary" disabled="@Busy">
        @(Busy ? "Uploading…" : "Add game")
    </button>
</EditForm>

@*
    Outside the EditForm above — see the comment in TagEditor. Chosen before the upload starts and
    applied the moment the server hands back the new game's id, so the contributor describes the game
    once rather than uploading it and then going to find it again.
*@
<div class="mt-4">
    <label class="form-label">Tags (optional)</label>
    <p class="gt-data mb-2">How it gets played. Applied once the upload finishes.</p>
    <TagEditor Names="Tags" NamesChanged="names => Tags = names" Disabled="@Busy" />
</div>

<div class="mt-4">
    <label class="form-label">Instructions in the download</label>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="bake-guide"
               checked="@BakeGuide"
               disabled="@(Busy || !CanBakeGuide)"
               @onchange="e => BakeGuide = e.Value is true" />
        <label class="form-check-label" for="bake-guide">
            Include a <code>GameTownGuide.txt</code> inside the archive
        </label>
    </div>
    <p class="gt-data mb-0 mt-1">
        @if (SelectedFile is null)
        {
            <span>Choose an archive first — only ZIP files can carry one.</span>
        }
        else if (!CanBakeGuide)
        {
            <span>
                @SelectedFile.Name is not a ZIP. A ZIP keeps its index at the end, so a file can be
                added without repacking it; RAR and 7z would have to be rebuilt.
            </span>
        }
        else
        {
            <span>
                Written in after the upload finishes, so the instructions are there after extracting.
                The archive is not repacked and the upload is not slowed down.
            </span>
        }
    </p>
</div>

@code {
    private AddGameRequest Request = new();
    private List<string> Tags = [];
    private bool BakeGuide;

    /// <summary>
    /// Whether the chosen file can carry a guide. Decided here from the file name so the toggle
    /// reacts as soon as a file is picked, rather than after the upload has already happened; the
    /// server decides for real, from the archive it actually stored.
    /// </summary>
    private bool CanBakeGuide =>
        SelectedFile is not null
        && ".zip".Equals(Path.GetExtension(SelectedFile.Name), StringComparison.OrdinalIgnoreCase);

    /// <summary>Set after a successful upload, so the success banner can offer a way to the new game.</summary>
    private Guid? AddedGameId;

    private InputFile? fileInput;
    private IBrowserFile? SelectedFile;
    private RawgGameContract? SelectedRawgGame;
    private DotNetObjectReference<AddGame>? selfRef;

    private bool Busy;
    private string? Error;
    private string? Notice;

    private long UploadedBytes;
    private long TotalBytes;

    private int Percent => TotalBytes > 0 ? (int)(UploadedBytes * 100 / TotalBytes) : 0;

    /// <summary>True once the last byte is sent and the server has yet to answer.</summary>
    private bool Processing;
    private int ProcessingSeconds;
    private CancellationTokenSource? processingClock;

    /// <summary>Striped and animated when there is no meaningful percentage to show.</summary>
    private bool Indeterminate => Processing || TotalBytes == 0;

    private string StatusText => Processing
        ? "Saving on the server…"
        : TotalBytes > 0
            ? $"{Percent}% · {FormatSize(UploadedBytes)} of {FormatSize(TotalBytes)}"
            : "Starting upload…";

    private UploadLimitsContract? Limits;

    // Fallbacks for the case where the limits could not be fetched. Permissive on purpose: the
    // server enforces both regardless, and guessing a stricter rule here would block uploads the
    // server would have accepted.
    private static readonly string[] FallbackExtensions = [".zip", ".rar", ".7z"];

    private string[] AllowedExtensions =>
        Limits is { AllowedFileTypes.Count: > 0 } ? [.. Limits.AllowedFileTypes] : FallbackExtensions;

    private string AcceptAttribute => string.Join(",", AllowedExtensions);

    /// <summary>Zero means the server has no ceiling configured.</summary>
    private long MaxUploadBytes => (Limits?.MaxUploadSizeMb ?? 0) * 1024L * 1024L;

    protected override async Task OnInitializedAsync()
        => Limits = await GamesService.GetUploadLimits();

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        Error = null;

        // Swapping a ZIP for a RAR must not leave a ticked box that cannot be honoured. The server
        // would refuse it anyway; this keeps the form from claiming otherwise in the meantime.
        if (!CanBakeGuide) BakeGuide = false;
    }

    private void OnRawgGameSelected(RawgGameContract? game)
    {
        SelectedRawgGame = game;
        Request.RawgGameId = game?.Id?.ToString();
    }

    private void ClearRawgGame()
    {
        SelectedRawgGame = null;
        Request.RawgGameId = null;
    }

    /// <summary>Called from upload.js as the transfer advances.</summary>
    [JSInvokable]
    public Task OnUploadProgress(long loaded, long total)
    {
        UploadedBytes = loaded;
        TotalBytes = total;

        // The browser fires a final progress event when the last byte goes out, and everything after
        // it is server-side work the client cannot see. That transition is the only signal available
        // for switching the UI over, so take it — but only once; the event can repeat at 100%.
        if (!Processing && total > 0 && loaded >= total)
            StartProcessingClock();

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void StartProcessingClock()
    {
        Processing = true;
        ProcessingSeconds = 0;
        processingClock = new CancellationTokenSource();
        _ = TickAsync(processingClock.Token);
    }

    // Not a System.Threading.Timer: on WASM there is one thread, and a plain awaited loop keeps
    // every mutation on the same context the renderer runs on.
    private async Task TickAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                ProcessingSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Upload finished or the page went away.
        }
    }

    private void StopProcessingClock()
    {
        processingClock?.Cancel();
        processingClock?.Dispose();
        processingClock = null;
        Processing = false;
        ProcessingSeconds = 0;
    }

    private async Task Submit()
    {
        Error = null;
        Notice = null;
        AddedGameId = null;

        if (SelectedFile is null || fileInput?.Element is null)
        {
            Error = "Please choose a game archive to upload.";
            return;
        }

        var extension = Path.GetExtension(SelectedFile.Name).ToLowerInvariant();
        if (!AllowedExtensions.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            Error = $"Invalid file format. Allowed types: {string.Join(", ", AllowedExtensions)}.";
            return;
        }

        // Checked before the upload starts, not after. Both this and the type check above are
        // courtesies — the server enforces the same two rules — but without them a contributor
        // spends twenty minutes uploading an archive only to be told the size limit at the end.
        if (MaxUploadBytes > 0 && SelectedFile.Size > MaxUploadBytes)
        {
            Error = $"That file is {FormatSize(SelectedFile.Size)}, over this server's "
                  + $"{Limits!.MaxUploadSizeMb} MB upload limit.";
            return;
        }

        Busy = true;
        UploadedBytes = 0;
        TotalBytes = 0;

        selfRef ??= DotNetObjectReference.Create(this);

        // The browser streams the file straight from the input element; it never passes through
        // .NET, which is what makes large archives viable.
        var outcome = await UploadService.UploadGameAsync(
            fileInput.Element.Value,
            GamesService.GetAddGameUrl(),
            Request,
            selfRef);

        StopProcessingClock();

        if (outcome.Result.Success)
        {
            var title = Request.Title;
            Notice = $"'{title}' was added.";

            // Tags go up separately, once the archive is in and the game has an id. Failing here is
            // reported without retracting the success above: the game IS added, and saying otherwise
            // would send the contributor back to upload it a second time.
            if (outcome.GameId is { } gameId && Tags.Count > 0)
            {
                var (tagResult, _) = await GamesService.SetGameTags(gameId, Tags);
                if (!tagResult.Success)
                    Error = $"'{title}' was added, but its tags were not saved: {tagResult.Error}";
            }

            // Written after the upload rather than during it, so the archive reaches its final
            // location untouched and a failure here cannot cost the transfer. Same rule as the tags
            // above: the game is added either way, and saying otherwise would send the contributor
            // back to upload it a second time.
            if (outcome.GameId is { } bakeId && BakeGuide)
            {
                var (guideResult, _) = await GamesService.SetArchiveGuide(bakeId, baked: true);
                if (!guideResult.Success)
                    Error = $"'{title}' was added, but the instructions were not written into the "
                          + $"archive: {guideResult.Error}";
            }

            // A link rather than a redirect. The common case is adding several games in a row, and
            // navigating away after each one would make that needlessly slow — but cover art lives on
            // the detail page, so the way there has to be one click.
            if (outcome.GameId is { } addedId)
                AddedGameId = addedId;

            Request = new AddGameRequest();
            SelectedFile = null;
            SelectedRawgGame = null;
            Tags = [];
            BakeGuide = false;
        }
        else
        {
            Error = outcome.Result.Error;
        }

        Busy = false;
        UploadedBytes = 0;
        TotalBytes = 0;
    }

    private async Task Cancel() => await UploadService.AbortAsync();

    public async ValueTask DisposeAsync()
    {
        // Abort anything still running, or the upload outlives the page it belongs to.
        StopProcessingClock();
        await UploadService.AbortAsync();
        selfRef?.Dispose();
    }

    private static string FormatSize(long bytes)
    {
        double mb = bytes / (1024.0 * 1024.0);
        return mb < 1 ? $"{bytes / 1024.0:0.#} KB" : $"{mb:0.##} MB";
    }

    private static string FormatElapsed(int seconds)
        => seconds < 60 ? $"{seconds}s" : $"{seconds / 60}m {seconds % 60:00}s";
}

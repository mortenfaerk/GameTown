@page "/game/{Id}"
@inject GamesService GamesService
@inject NavigationManager Navigation

@* Public, like the library. Download needs no auth either — only editing does. *@

<PageTitle>@(Game?.Title ?? "Game")</PageTitle>

@if (Loading)
{
    <p class="gt-muted">Loading…</p>
}
else if (Error is not null && Game is null)
{
    <div class="alert alert-danger">@Error</div>
    <a class="btn btn-outline-secondary" href="/">Back to the library</a>
}
else if (Game is null)
{
    <div class="card">
        <div class="card-body">
            <p class="mb-2">That game is not on the shelf.</p>
            <a class="btn btn-outline-secondary" href="/">Back to the library</a>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger alert-dismissible">
            @Error
            <button type="button" class="btn-close" @onclick="() => Error = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Notice))
    {
        <div class="alert alert-success alert-dismissible">
            @Notice
            <button type="button" class="btn-close" @onclick="() => Notice = null"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4 col-lg-3">
            <div class="tile__art">
                @if (Cover is not null)
                {
                    <img src="@Cover" alt="Cover art for @Game.Title" />
                }
                else
                {
                    <div class="tile__fallback">@GamesService.InitialsFor(Game.Title)</div>
                }
            </div>
        </div>

        <div class="col-12 col-md-8 col-lg-9">
            <h1 class="mb-1">@Game.Title</h1>
            <p class="gt-data mb-3">
                @FormatSize(Game.Size)
                @if (Game.Metadata?.Released is not null)
                {
                    <span> · released @Game.Metadata.Released.Value.ToString("yyyy-MM-dd")</span>
                }
                @*
                    "critic score", not "metacritic". It IS Metacritic on a row carried over from
                    RAWG and IGDB's own aggregate on anything since, and the page cannot tell the
                    reader which without saying something false about the other.
                *@
                @if (Game.Metadata?.CriticScore is not null)
                {
                    <span> · critic score @Math.Round(Game.Metadata.CriticScore.Value)</span>
                }
            </p>

            @if (Game.Metadata is not null)
            {
                <p class="mb-1"><span class="gt-muted">Genres:</span>
                    @(Game.Metadata.Genres.Count == 0 ? "—" : string.Join(", ", Game.Metadata.Genres.Select(g => g.Name)))
                </p>
                <p class="mb-3"><span class="gt-muted">Developers:</span>
                    @(Game.Metadata.Developers.Count == 0 ? "—" : string.Join(", ", Game.Metadata.Developers.Select(d => d.Name)))
                </p>
            }

            @* Linked, not just listed: a tag is a way into the library, and its whole value is being
               able to ask "what else can we play split screen" from the game that reminded you. *@
            @if (Game.Tags.Count > 0)
            {
                <div class="gt-tags__chips mb-3">
                    @foreach (var tag in Game.Tags)
                    {
                        <a class="gt-tag gt-tag--link" href="@($"/?tags={tag.Slug}")">@tag.Name</a>
                    }
                </div>
            }

            @* Suggested at a LAN, and linked for the same reason the tags are: "what else did people
               ask for that weekend" is the obvious next question from a game that was on the list.

               Event names come from Discord. Rendered as text, never as markup — see
               SECURITY-NOTES.md risk 10. *@
            @if (Game.SuggestedFor.Count > 0)
            {
                <p class="gt-muted mb-3">
                    @(Game.PlayedAtLan ? "Played at" : "Suggested for")
                    @foreach (var lanEvent in Game.SuggestedFor)
                    {
                        <a class="ms-1" href="@($"/?lan={Uri.EscapeDataString(lanEvent)}")">@lanEvent</a>
                    }
                </p>
            }

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="@GamesService.GetDownloadUrl(Game.Id)">Download</a>

                <AuthorizeView Roles="Admin,Contributor">
                    <Authorized>
                        @if (Edit is null)
                        {
                            <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="StartEdit">Edit</button>
                        }
                        @*
                            Only for metadata from the CURRENT provider. A game still carrying
                            RAWG data has nothing to refresh from — the service is gone — so the
                            button would fail every time it was pressed. Re-matching such a game is
                            what the admin re-link tool is for.
                        *@
                        @if (CanRefreshMetadata)
                        {
                            <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="RefreshMetadata">
                                @(Busy ? "Refreshing…" : "Refresh metadata")
                            </button>
                        }
                        @if (ConfirmDelete)
                        {
                            <button class="btn btn-danger" disabled="@Busy" @onclick="Delete">Confirm delete</button>
                            <button class="btn btn-outline-secondary" @onclick="() => ConfirmDelete = false">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete = true">Delete</button>
                        }
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>

    @*
        Five things are edited here and two of them save themselves, so each section says which it is
        and the commit sits at the end of what it commits — the argument written above the add-game
        button, applied to the page that needed it more. It used to be a stack of <hr>s with Save in
        the middle, above three sections that looked like they arrived too late to be included.
    *@
    @if (Edit is not null)
    {
        <div class="card gt-edit mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">Edit game</h5>

                @*
                    id + the buttons' form="edit-game" in the footer. Only the two text fields are in
                    the form: everything below handles Enter itself or saves on its own.
                *@
                <EditForm id="edit-game" Model="Edit" OnValidSubmit="SaveEdit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="gt-edit__section gt-edit__section--first">
                        <div class="gt-edit__head"><span class="gt-eyebrow">Details</span></div>

                        <div class="mb-3">
                            <label class="form-label" for="edit-title">Title</label>
                            <InputText id="edit-title" class="form-control" @bind-Value="Edit.Title" disabled="@Busy" />
                        </div>

                        <div class="mb-0">
                            <label class="form-label" for="edit-howto">How to play / install</label>
                            <InputTextArea id="edit-howto" class="form-control" rows="4" @bind-Value="Edit.HowTo" disabled="@Busy" />
                        </div>
                    </div>
                </EditForm>

                @* Outside the EditForm above — see MetadataPicker and TagEditor: both take Enter, and
                   a text input nested in a form submits that form on Enter. *@
                <div class="gt-edit__section">
                    <div class="gt-edit__head"><span class="gt-eyebrow">Metadata match</span></div>
                    <p class="gt-data mb-2">
                        Where the description, genres and provider artwork come from.
                        @if (EditMetadata is null)
                        {
                            <span>Nothing is attached yet.</span>
                        }
                    </p>
                    @*
                        Seeded with the game's current match, so the panel opens showing what this game
                        is already linked to — cover and all — rather than one line of grey text.

                        AllowClear only when there is nothing to lose: the patch endpoint reads a null
                        provider id as "leave this alone", so Remove on a matched game would empty the
                        panel and then save the old match anyway.
                    *@
                    <MetadataPicker Selected="EditMetadata" SelectedChanged="OnEditMetadataSelected"
                                    Placeholder="Search to re-match this game…"
                                    AllowClear="@(Game.Metadata is null)"
                                    ShowDetails="true" Disabled="@Busy" />
                </div>

                <div class="gt-edit__section">
                    <div class="gt-edit__head"><span class="gt-eyebrow">Tags</span></div>
                    <p class="gt-data mb-2">How it gets played. Saved with the rest of the changes.</p>
                    <TagEditor Names="EditTags" NamesChanged="names => EditTags = names" Disabled="@Busy" />
                </div>

                @* Saves on its own, because it writes to a file on disk and can fail in ways that
                   must not retract a save that already worked. *@
                <div class="gt-edit__section">
                    <div class="gt-edit__head">
                        <span class="gt-eyebrow">Instructions in the download</span>
                        <span class="gt-edit__now">saves immediately</span>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="bake-guide"
                               checked="@Game.GuideBaked"
                               disabled="@(Busy || !Game.CanBakeGuide)"
                               @onchange="OnGuideToggled" />
                        <label class="form-check-label" for="bake-guide">
                            Include a <code>GameTownGuide.txt</code> inside the archive
                        </label>
                    </div>
                    <p class="gt-data mb-0 mt-1">
                        @if (!Game.CanBakeGuide)
                        {
                            <span>
                                Only ZIP archives can carry one. A ZIP keeps its index at the end, so a file
                                can be added without repacking; RAR and 7z would have to be rebuilt.
                            </span>
                        }
                        else if (Game.GuideBaked)
                        {
                            <span>The archive carries a copy of the instructions above. Saving changes rewrites it.</span>
                        }
                        else
                        {
                            <span>Adds the instructions to the archive so they are there after extracting. The archive is not repacked.</span>
                        }
                    </p>
                </div>

                <div class="gt-edit__section">
                    <div class="gt-edit__head">
                        <span class="gt-eyebrow">Cover art</span>
                        <span class="gt-edit__now">saves immediately</span>
                    </div>
                    <p class="gt-data mb-2">
                        @if (Game.BoxArtUrl is not null)
                        {
                            <span>This game has its own cover. </span>
                            <button type="button" class="btn btn-sm btn-link p-0 align-baseline"
                                    disabled="@Busy" @onclick="ClearBoxArt">Remove it</button>
                            <span> to fall back to the provider's image.</span>
                        }
                        else
                        {
                            <span>Using the provider's image. Pick a cover to replace it.</span>
                        }
                    </p>
                    <BoxArtPicker GameId="Game.Id" Title="@Game.Title"
                                  Changed="OnBoxArtChanged" Failed="message => Error = message" />
                </div>

                @* The commit, at the end of what it commits. form="edit-game" rather than nesting;
                   see the comment on the EditForm above. *@
                <div class="gt-edit__footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@Busy" @onclick="CancelEdit">Cancel</button>
                    <button type="submit" form="edit-game" class="btn btn-primary" disabled="@Busy">
                        @(Busy ? "Saving…" : "Save changes")
                    </button>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">How to play</h5>
            <p class="card-text mb-0" style="white-space: pre-wrap;">@Game.HowTo</p>
        </div>
    </div>

    @if (Game.Metadata is not null && !string.IsNullOrWhiteSpace(Game.Metadata.Description))
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">About</h5>
                <div class="card-text">@((MarkupString)Game.Metadata.Description)</div>
            </div>
        </div>
    }

    @if (ShotUrls.Count > 0)
    {
        <h5 class="mb-3">Screenshots</h5>
        <div class="shots mb-4">
            @for (var i = 0; i < ShotUrls.Count; i++)
            {
                var index = i; // captured per iteration, or every button would open the last one
                <button type="button" class="shot" @onclick="() => lightboxIndex = index"
                        aria-label="@($"View screenshot {index + 1} of {ShotUrls.Count} full screen")">
                    <img src="@ShotUrls[index]" alt="Screenshot of @Game.Title" loading="lazy" />
                </button>
            }
        </div>
    }

    <a class="btn btn-outline-secondary" href="/">Back to the library</a>

    <ScreenshotLightbox Images="ShotUrls"
                        Caption="@Game.Title"
                        Index="lightboxIndex"
                        IndexChanged="i => lightboxIndex = i" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private GameContract? Game;

    /// <summary>
    /// Whether "Refresh metadata" is worth offering. The server decides — see
    /// GameContract.CanRefreshMetadata — because a game carrying metadata from a retired provider has
    /// nothing to refresh from, and only the server knows which provider is configured.
    /// </summary>
    private bool CanRefreshMetadata => Game?.CanRefreshMetadata == true;
    private bool Loading = true;
    private bool Busy;
    private bool ConfirmDelete;
    private string? Error;
    private string? Notice;

    private int? lightboxIndex;

    private GameTownGamePatchRequest? Edit;

    /// <summary>
    /// What the picker shows while editing: the game's current match, then whatever replaces it.
    ///
    /// Seeded from the loaded game rather than starting empty — an edit panel that shows no match on
    /// a game that has one reads as "this game has no metadata", and re-matching then looks like the
    /// only thing on offer.
    /// </summary>
    private GameMetadataContract? EditMetadata;

    private List<string> EditTags = [];

    /// <summary>
    /// Title and HowTo are pre-populated from the loaded game on purpose: the patch request treats
    /// null as "leave unchanged", so a blank model would look like an edit that silently did nothing.
    ///
    /// ProviderGameId is deliberately NOT pre-populated, and the same rule is the reason. The server
    /// re-fetches from the provider for any non-null value, so seeding it made every save — a title
    /// typo, a line added to the instructions — a round trip to the metadata provider. On a game
    /// carrying RAWG data that fails outright (there is nothing to fetch from), and once IGDB
    /// credentials exist it is worse than failing: a RAWG id is a perfectly valid IGDB id belonging
    /// to some other game, so the save would quietly re-link the game to it. That is the same
    /// mistake the re-link screen exists to prevent and that CanRefreshMetadata already guards the
    /// refresh button against. Left null, the metadata is only touched when a match is actually
    /// picked — see OnEditMetadataSelected.
    /// </summary>
    private void StartEdit()
    {
        if (Game is null) return;

        Edit = new GameTownGamePatchRequest
        {
            Id = Game.Id.ToString(),
            Title = Game.Title,
            HowTo = Game.HowTo
        };
        EditMetadata = Game.Metadata;
        EditTags = [.. Game.Tags.Select(t => t.Name)];
        Error = null;
        Notice = null;
    }

    private void CancelEdit()
    {
        Edit = null;
        EditMetadata = null;
        EditTags = [];
    }

    /// <summary>
    /// Box art saves on its own, not with the rest of the form.
    ///
    /// Picking a cover is a click on a picture, and a click on a picture that then needs a separate
    /// Save reads as broken. The endpoint answers with the updated game, so the page refreshes from
    /// the response rather than re-fetching.
    /// </summary>
    private async Task OnBoxArtChanged(GameContract updated)
    {
        Game = updated;
        Error = null;
        Notice = "Cover art updated.";
        await Task.CompletedTask;
    }

    /// <summary>
    /// Applies immediately rather than waiting for Save, like the cover picker above it.
    ///
    /// Both write to a file rather than to a row, and both can fail on their own terms — a damaged
    /// archive, a share that has gone read-only — so folding them into the form's save would mean one
    /// button that half-succeeds.
    /// </summary>
    private async Task OnGuideToggled(ChangeEventArgs e)
    {
        if (Game is null) return;

        var wanted = e.Value is true;

        Busy = true;
        Error = null;
        Notice = null;

        var (result, updated) = await GamesService.SetArchiveGuide(Game.Id, wanted);

        if (result.Success && updated is not null)
        {
            Game = updated;
            Notice = wanted
                ? "The instructions are now inside the archive."
                : "The instructions were removed from the archive.";
        }
        else
        {
            // The checkbox is bound to Game.GuideBaked, which has not changed — so re-rendering puts
            // it back where it was, and the tick does not sit there claiming something that failed.
            Error = result.Error;
        }

        Busy = false;
    }

    private async Task ClearBoxArt()
    {
        if (Game is null) return;

        Busy = true;
        Error = null;
        Notice = null;

        var result = await GamesService.ClearBoxArt(Game.Id);
        if (result.Success)
        {
            await LoadGame();
            Notice = "Cover art removed.";
        }
        else
        {
            Error = result.Error;
        }

        Busy = false;
    }

    /// <summary>
    /// Takes null as well as a match: on a game with no metadata the picker offers Remove, and a null
    /// provider id is what the patch endpoint reads as "leave this alone" — which for that game means
    /// leaving it unmatched. On a game that already has metadata the picker does not offer Remove at
    /// all, because there the same null would silently keep the old match.
    /// </summary>
    private void OnEditMetadataSelected(GameMetadataContract? game)
    {
        if (Edit is null) return;
        EditMetadata = game;
        Edit.ProviderGameId = game?.ExternalId.ToString();
    }

    private async Task SaveEdit()
    {
        if (Edit is null) return;

        Busy = true;
        Error = null;
        Notice = null;

        var result = await GamesService.UpdateGame(Edit);

        if (result.Success)
        {
            // Tags go through their own endpoint, so this is a second call rather than part of the
            // patch. Sent unconditionally rather than only when they changed: the request replaces
            // the whole set and is idempotent, so a no-op costs one round trip and removes the need
            // to track a dirty flag that could be wrong.
            var (tagResult, _) = await GamesService.SetGameTags(Guid.Parse(Edit.Id), EditTags);

            if (!tagResult.Success)
            {
                // The game itself did save, so say what did and did not rather than reporting the
                // whole edit as failed — reloading here would otherwise look like nothing happened.
                Error = $"The game was saved, but its tags were not: {tagResult.Error}";
                await LoadGame();
                Busy = false;
                return;
            }

            CancelEdit();
            await LoadGame();
            Notice = "Changes saved.";
        }
        else
        {
            Error = result.Error;
        }

        Busy = false;
    }

    private List<ScreenshotContract> Screenshots =>
        Game?.Metadata?.Screenshots.Where(s => !s.IsDeleted && !string.IsNullOrWhiteSpace(s.Image)).ToList() ?? [];

    /// <summary>Screenshot URLs already resolved against the API, shared by the strip and the viewer.</summary>
    private List<string> ShotUrls =>
        Screenshots.Select(s => GamesService.ResolveMedia(s.Image))
                   .Where(u => !string.IsNullOrWhiteSpace(u))
                   .Select(u => u!)
                   .ToList();

    /// <summary>
    /// Box art, then the provider's image, then a screenshot. The precedence lives in GamesService so the
    /// shelf and this page cannot disagree about what a game looks like.
    /// </summary>
    private string? Cover => Game is null ? null : GamesService.CoverFor(Game);

    private string? loadedId;

    protected override async Task OnParametersSetAsync()
    {
        // Only reload when the route id actually changes. Parameters are set again on every
        // cascading auth-state change, and reloading on each one caused redundant fetches.
        if (loadedId == Id) return;
        loadedId = Id;
        await LoadGame();
    }

    private async Task LoadGame()
    {
        Loading = true;

        if (!Guid.TryParse(Id, out var gameId))
        {
            Error = "That is not a valid game id.";
            Loading = false;
            return;
        }

        try
        {
            Game = await GamesService.GetById(gameId);
        }
        catch (Exception ex)
        {
            Error = $"Could not load the game: {ex.Message}";
        }
        Loading = false;
    }

    /// <summary>
    /// Re-sends the game's existing provider id, which routes through EnsurePersistedAsync and
    /// refreshes every stored field. Repairs rows written before the snake_case deserialisation
    /// fix — those have no cover art — and picks up later changes on RAWG's side.
    /// </summary>
    private async Task RefreshMetadata()
    {
        if (!CanRefreshMetadata) return;

        Busy = true;
        Error = null;
        Notice = null;

        var result = await GamesService.UpdateGame(new GameTownGamePatchRequest
        {
            Id = Game.Id.ToString(),
            ProviderGameId = Game!.Metadata!.ExternalId.ToString()
        });

        if (result.Success)
        {
            await LoadGame();
            Notice = "Metadata refreshed.";
        }
        else
        {
            Error = result.Error;
        }

        Busy = false;
    }

    private async Task Delete()
    {
        if (Game is null) return;

        Busy = true;
        var result = await GamesService.DeleteGame(Game.Id);
        Busy = false;

        if (result.Success)
            Navigation.NavigateTo("/");
        else
            Error = result.Error;
    }

    private static string FormatSize(double megabytes)
        => megabytes < 1 ? $"{megabytes * 1024:0.#} KB" : $"{megabytes:0.#} MB";
}

@page "/"
@inject GamesService GamesService
@inject NavigationManager Navigation

@* Public by design: anyone on the LAN browses and downloads. Only contributing is gated. *@

<PageTitle>GameTown</PageTitle>

@*
    One heading, always "Library".

    Selecting a tag used to retitle the page "Results" and print "tagged lan + co-op" beside it, which
    made narrowing the shelf feel like leaving it — a separate screen you then had to find your way
    back from. The chips below already say what is on, so the heading has nothing left to add and the
    page stays the place you were.
*@
<div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Library</h1>

    @if (IsSearching)
    {
        <span class="gt-muted">
            matching &ldquo;<span class="gt-mist-strong">@Q</span>&rdquo;
            <a class="ms-2" href="/">Clear</a>
        </span>
    }
    else if (!Loading && Games.Count > 0)
    {
        <span class="gt-data">@Games.Count on this page</span>
    }
</div>

@*
    The tag filter. Quick-add tags always show; anything else only once it is in use, so a library
    with three tags does not get a bar built for thirty.

    A chip is a toggle and reads as one: on chips take the accent, the shelf below narrows, and
    nothing else on the page changes. It carries no game count — the number sat hard against the name
    ("LAN5") and read as an index rather than as a quantity, and a count that rises every time anyone
    uploads anything is noise on a control whose only job is on or off.

    Toggling navigates rather than filtering in component state, so the narrowed shelf keeps a URL —
    the same reasoning that puts search in ?q=. Same page, same heading; only the address and the
    shelf change. It is the difference between "look at this" being a link and being a set of
    instructions.
*@
@if (FilterTags.Count > 0)
{
    // Once, not once per chip: SelectedTags parses the query string and allocates on every read.
    var selected = SelectedTags;

    <div class="gt-tags__chips mb-4">
        @foreach (var tag in FilterTags)
        {
            var captured = tag;
            var on = selected.Contains(captured.Slug);
            <button type="button" class="@(on ? "gt-tag gt-tag--on" : "gt-tag")"
                    aria-pressed="@on.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleTag(captured.Slug)">
                @captured.Name
            </button>
        }

        @if (selected.Count > 0)
        {
            @* Deliberately not a chip: it is not a tag, and dressing it as one would put a fifth
               thing in a row of four that behaves differently when clicked. Keeps any ?q= —
               clearing the tags is not the same request as abandoning the search. *@
            <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearTags">Clear tags</button>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (Loading)
{
    <p class="gt-muted">Loading the shelf…</p>
}
else if (Games.Count == 0)
{
    <div class="card">
        <div class="card-body">
            @if (IsFiltered)
            {
                <p class="mb-0">Nothing matches that. <a href="/">Show the whole library</a>.</p>
            }
            else
            {
                <p class="mb-1">The shelf is empty.</p>
                <AuthorizeView Roles="Admin,Contributor">
                    <Authorized>
                        <p class="gt-muted mb-0"><a href="addgame">Add the first game</a>.</p>
                    </Authorized>
                    <NotAuthorized>
                        <p class="gt-muted mb-0">A contributor needs to upload something first.</p>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>
    </div>
}
else
{
    <div class="shelf">
        @foreach (var game in Games)
        {
            var cover = GamesService.CoverFor(game);
            <a class="tile" href="@($"/game/{game.Id}")">
                <div class="tile__art">
                    @if (cover is not null)
                    {
                        <img src="@cover" alt="Cover art for @game.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="tile__fallback">@GamesService.InitialsFor(game.Title)</div>
                    }
                    <span class="tile__size">@FormatSize(game.Size)</span>
                </div>
                <p class="tile__title">@game.Title</p>
                <p class="tile__meta">
                    @* Tags before genres: they are the ones somebody chose to write down, and the
                       ones being filtered on just above. Genres fill the line when there are none. *@
                    @if (game.Tags.Count > 0)
                    {
                        @string.Join(" · ", game.Tags.Take(3).Select(t => t.Name))
                    }
                    else if (game.RawgGame?.Genres.Count > 0)
                    {
                        @string.Join(" · ", game.RawgGame.Genres.Take(3).Select(g => g.Name))
                    }
                    else
                    {
                        <span>&nbsp;</span>
                    }
                </p>
            </a>
        }
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5">
        <button class="btn btn-sm btn-outline-secondary" disabled="@(Page <= 1)" @onclick="() => Load(Page - 1)">Previous</button>
        <span class="gt-data">Page @Page</span>
        @* The API returns a bare list with no total, so a full page implies there may be more. *@
        <button class="btn btn-sm btn-outline-secondary" disabled="@(Games.Count < PageSize)" @onclick="() => Load(Page + 1)">Next</button>
    </div>
}

@code {
    /// <summary>Set by the sidebar search, which navigates to /?q=… so results stay linkable.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>
    /// Selected tag slugs, comma-separated, e.g. "/?tags=lan,co-op".
    ///
    /// In the URL rather than in component state for the same reason the search query is: a shelf
    /// narrowed to "what four of us can play" is exactly the thing someone wants to paste to the
    /// other three.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tags")]
    public string? TagFilter { get; set; }

    private List<GameContract> Games = [];
    private List<TagContract> FilterTags = [];
    private int Page = 1;
    private const int PageSize = 24;
    private bool Loading = true;
    private string? Error;
    private string? loadedQuery;
    private string? loadedTags;

    private bool hasLoaded;

    private bool IsSearching => !string.IsNullOrWhiteSpace(Q);
    private bool IsFiltered => IsSearching || SelectedTags.Count > 0;

    private List<string> SelectedTags =>
        string.IsNullOrWhiteSpace(TagFilter)
            ? []
            : [.. TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Every tag that is either offered as a quick add or actually in use. A tag nobody has
            // applied and nobody offers is not a filter anyone can want.
            FilterTags = [.. (await GamesService.GetTags()).Where(t => t.IsQuickAdd || t.GameCount > 0)];
        }
        catch (Exception)
        {
            // The library is the page; the filter bar is not worth failing it over.
            FilterTags = [];
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-runs whenever ?q= or ?tags= changes, including navigating back to the unfiltered library.
        //
        // The guard keys off an explicit flag rather than Loading: parameters get set again whenever
        // the cascading auth state resolves or changes (e.g. right after login), and if that landed
        // mid-request the old guard let a *second* concurrent Load start. Two in-flight fetches then
        // raced to assign Games, which is why the shelf sometimes came up empty.
        if (hasLoaded && loadedQuery == Q && loadedTags == TagFilter) return;

        hasLoaded = true;
        loadedQuery = Q;
        loadedTags = TagFilter;
        await Load(1);
    }

    /// <summary>
    /// Adds or removes a tag from the filter and navigates to the resulting URL.
    ///
    /// Page is deliberately not preserved: a narrower filter has fewer pages, and page 4 of a
    /// three-page result is an empty shelf that looks like the filter matched nothing.
    /// </summary>
    private void ToggleTag(string slug)
    {
        var selected = SelectedTags;
        GoTo(selected.Contains(slug)
            ? selected.Where(s => s != slug).ToList()
            : [.. selected, slug]);
    }

    private void ClearTags() => GoTo([]);

    /// <summary>Navigates to the library with exactly these tags selected, keeping any search term.</summary>
    private void GoTo(List<string> tags)
    {
        var parameters = new List<string>();
        if (IsSearching) parameters.Add($"q={Uri.EscapeDataString(Q!)}");
        if (tags.Count > 0) parameters.Add($"tags={Uri.EscapeDataString(string.Join(',', tags))}");

        Navigation.NavigateTo(parameters.Count == 0 ? "/" : "/?" + string.Join('&', parameters));
    }

    private async Task Load(int page)
    {
        if (page < 1) return;

        Loading = true;
        Error = null;
        try
        {
            var tags = SelectedTags;
            Games = IsSearching
                ? await GamesService.Search(Q!, page, PageSize, tags)
                : await GamesService.GetPaged(page, PageSize, tags);
            Page = page;
        }
        catch (Exception ex)
        {
            Error = $"Could not load the library: {ex.Message}";
            Games = [];
        }
        Loading = false;
    }

    private static string FormatSize(double megabytes)
        => megabytes < 1 ? $"{megabytes * 1024:0.#} KB" : $"{megabytes:0.#} MB";
}

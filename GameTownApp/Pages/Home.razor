@page "/"
@inject GamesService GamesService
@inject NavigationManager Navigation
@inject LanSuggestionService LanService
@inject ShelfCache ShelfCache
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Public by design: anyone on the LAN browses and downloads. Only contributing is gated. *@

<PageTitle>GameTown</PageTitle>

@*
    One heading, always "Library".

    Selecting a tag used to retitle the page "Results" and print "tagged lan + co-op" beside it, which
    made narrowing the shelf feel like leaving it — a separate screen you then had to find your way
    back from. The chips below already say what is on, so the heading has nothing left to add and the
    page stays the place you were.
*@
<div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Library</h1>

    @if (IsSearching)
    {
        <span class="gt-muted">
            matching &ldquo;<span class="gt-mist-strong">@Q</span>&rdquo;
            <a class="ms-2" href="/">Clear</a>
        </span>
    }
    else if (!Loading && Games.Count > 0)
    {
        @* "of N" because an endless shelf has no page number to say how far along you are. *@
        <span class="gt-data">@CountLabel</span>
    }
</div>

@*
    The tag filter. Quick-add tags always show; anything else only once it is in use, so a library
    with three tags does not get a bar built for thirty.

    A chip is a toggle and reads as one: on chips take the accent, the shelf below narrows, and
    nothing else on the page changes. It carries no game count — the number sat hard against the name
    ("LAN5") and read as an index rather than as a quantity, and a count that rises every time anyone
    uploads anything is noise on a control whose only job is on or off.

    Toggling navigates rather than filtering in component state, so the narrowed shelf keeps a URL —
    the same reasoning that puts search in ?q=. Same page, same heading; only the address and the
    shelf change. It is the difference between "look at this" being a link and being a set of
    instructions.
*@
@if (FilterTags.Count > 0)
{
    // Once, not once per chip: SelectedTags parses the query string and allocates on every read.
    var selected = SelectedTags;

    <div class="gt-tags__chips mb-4">
        @foreach (var tag in FilterTags)
        {
            var captured = tag;
            var on = selected.Contains(captured.Slug);
            <button type="button" class="@(on ? "gt-tag gt-tag--on" : "gt-tag")"
                    aria-pressed="@on.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleTag(captured.Slug)">
                @captured.Name
            </button>
        }

        @if (selected.Count > 0)
        {
            @* Deliberately not a chip: it is not a tag, and dressing it as one would put a fifth
               thing in a row of four that behaves differently when clicked. Keeps any ?q= —
               clearing the tags is not the same request as abandoning the search. *@
            <button type="button" class="btn btn-link btn-sm p-0 ms-2" @onclick="ClearTags">Clear tags</button>
        }
    </div>
}

@*
    LAN events players have suggested games for.

    A separate row from the tags, not more chips in the same one. A tag says what a game IS and stays
    true forever; an event says what people asked for on one weekend, and mixing them would put two
    different kinds of claim in one control. Only one event can be on at a time — ANDing two LANs
    almost always returns nothing.

    Absent entirely on an install with no LAN bot, so the shelf is unchanged for everyone else.

    Event names come from Discord. Rendered as text, never as markup.
*@
@if (LanEvents.Count > 0)
{
    <div class="gt-tags__chips mb-4">
        <span class="gt-eyebrow me-2">Suggested for</span>
        @foreach (var lanEvent in LanEvents)
        {
            var captured = lanEvent;
            var on = string.Equals(LanFilter, captured.Name, StringComparison.OrdinalIgnoreCase);
            <button type="button" class="@(on ? "gt-tag gt-tag--on" : "gt-tag")"
                    aria-pressed="@on.ToString().ToLowerInvariant()"
                    @onclick="() => ToggleLan(captured.Name)">
                @captured.Name
            </button>
        }
    </div>
}

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (Loading)
{
    <p class="gt-muted">Loading the shelf…</p>
}
else if (Games.Count == 0)
{
    <div class="card">
        <div class="card-body">
            @if (IsFiltered)
            {
                <p class="mb-0">Nothing matches that. <a href="/">Show the whole library</a>.</p>
            }
            else
            {
                <p class="mb-1">The shelf is empty.</p>
                <AuthorizeView Roles="Admin,Contributor">
                    <Authorized>
                        <p class="gt-muted mb-0"><a href="addgame">Add the first game</a>.</p>
                    </Authorized>
                    <NotAuthorized>
                        <p class="gt-muted mb-0">A contributor needs to upload something first.</p>
                    </NotAuthorized>
                </AuthorizeView>
            }
        </div>
    </div>
}
else
{
    <div class="shelf">
        @foreach (var game in Games)
        {
            var cover = GamesService.CoverFor(game);
            <a class="tile" href="@($"/game/{game.Id}")" @onclick="RememberShelf">
                <div class="tile__art">
                    @if (cover is not null)
                    {
                        <img src="@cover" alt="Cover art for @game.Title" loading="lazy" />
                    }
                    else
                    {
                        <div class="tile__fallback">@GamesService.InitialsFor(game.Title)</div>
                    }
                    <span class="tile__size">@FormatSize(game.Size)</span>
                    @* Somebody asked for this one. Deliberately just a mark, not the event name:
                       the tile already carries a title, a size and a meta line, and a fourth piece
                       of text would crowd it — the chips above are where the name belongs. *@
                    @if (game.SuggestedFor.Count > 0)
                    {
                        <span class="tile__lan" title="@SuggestedTitle(game)">
                            @(game.PlayedAtLan ? "★" : "◆")
                        </span>
                    }
                </div>
                <p class="tile__title">@game.Title</p>
                <p class="tile__meta">
                    @* Tags before genres: they are the ones somebody chose to write down, and the
                       ones being filtered on just above. Genres fill the line when there are none. *@
                    @if (game.Tags.Count > 0)
                    {
                        @string.Join(" · ", game.Tags.Take(3).Select(t => t.Name))
                    }
                    else if (game.Metadata?.Genres.Count > 0)
                    {
                        @string.Join(" · ", game.Metadata.Genres.Take(3).Select(g => g.Name))
                    }
                    else
                    {
                        <span>&nbsp;</span>
                    }
                </p>
            </a>
        }
    </div>

    @*
        The end of the shelf. Normally nobody sees the button: the sentinel below asks for the next
        batch about a screen before it comes into view. It is here for keyboard and screen-reader
        users, who need a control rather than a scroll position, and as the way through if the
        observer never fires.

        A failed batch keeps everything already loaded and offers a retry in place - emptying the
        shelf because batch four failed would throw away three batches that worked.
    *@
    <div class="d-flex justify-content-center align-items-center gap-3 mt-5" aria-live="polite">
        @if (!string.IsNullOrEmpty(MoreError))
        {
            <span class="gt-muted">@MoreError</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="RetryMore">Retry</button>
        }
        else if (LoadingMore)
        {
            <span class="gt-muted">Loading more&hellip;</span>
        }
        else if (Next is not null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore">Load more</button>
        }
        else
        {
            <span class="gt-data">That&rsquo;s all @Games.Count</span>
        }
    </div>
}

@* Always rendered, so the observer attached on first render keeps watching the same element across
   every filter change. LoadMore decides whether there is anything to do. *@
<div @ref="sentinel" aria-hidden="true"></div>

@code {
    /// <summary>Set by the sidebar search, which navigates to /?q=… so results stay linkable.</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    /// <summary>
    /// Selected tag slugs, comma-separated, e.g. "/?tags=lan,co-op".
    ///
    /// In the URL rather than in component state for the same reason the search query is: a shelf
    /// narrowed to "what four of us can play" is exactly the thing someone wants to paste to the
    /// other three.
    /// </summary>
    [SupplyParameterFromQuery(Name = "tags")]
    public string? TagFilter { get; set; }

    /// <summary>
    /// A LAN event name, e.g. "/?lan=HCP%20%2337%20(2026)" — narrows the shelf to games somebody
    /// asked for at that LAN.
    ///
    /// In the URL for the same reason as the tags: "here is what people want to play this weekend"
    /// is exactly the thing to paste into a chat window.
    /// </summary>
    [SupplyParameterFromQuery(Name = "lan")]
    public string? LanFilter { get; set; }

    private List<GameContract> Games = [];
    private List<TagContract> FilterTags = [];
    private List<LanEventContract> LanEvents = [];

    /// <summary>
    /// Per batch. Twice the 24 the paged shelf used: a wide window shows that many in under two
    /// screens, so a smaller batch is just more round-trips for the same scroll.
    /// </summary>
    private const int BatchSize = 48;

    /// <summary>Cursor for the next batch; null once the shelf has reached the end.</summary>
    private string? Next;

    /// <summary>Matches across all batches, from the first one. Null if that has not arrived.</summary>
    private int? Total;

    private bool Loading = true;
    private bool LoadingMore;
    private string? Error;
    private string? MoreError;

    /// <summary>
    /// Bumped on every filter change. A batch that finishes after the filters moved on checks it and
    /// throws its result away - otherwise tiles from the shelf you just left get appended to the one
    /// you are now on. Cancellation alone is not enough: a response can complete in the same tick
    /// the token is cancelled.
    /// </summary>
    private int generation;
    private CancellationTokenSource? inflight;

    private string? loadedKey;
    private bool hasLoaded;

    private ElementReference sentinel;
    // In-process: WebAssembly can call JS synchronously, and RememberShelf has to read the scroll
    // position before the tile's navigation tears this page down.
    private IJSInProcessObjectReference? module;
    private DotNetObjectReference<Home>? selfRef;
    private bool observing;
    private bool recheckAfterRender;
    private double? restoreScrollTo;

    private string FilterKey => $"{Q}\u0001{TagFilter}\u0001{LanFilter}";

    private string CountLabel =>
        Total is null ? $"{Games.Count} games"
        : Next is null ? $"{Total} games"
        : $"{Games.Count} of {Total}";

    private bool IsSearching => !string.IsNullOrWhiteSpace(Q);
    private bool IsFiltered =>
        IsSearching || SelectedTags.Count > 0 || !string.IsNullOrWhiteSpace(LanFilter);

    private List<string> SelectedTags =>
        string.IsNullOrWhiteSpace(TagFilter)
            ? []
            : [.. TagFilter.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Every tag that is either offered as a quick add or actually in use. A tag nobody has
            // applied and nobody offers is not a filter anyone can want.
            FilterTags = [.. (await GamesService.GetTags()).Where(t => t.IsQuickAdd || t.GameCount > 0)];
        }
        catch (Exception)
        {
            // The library is the page; the filter bar is not worth failing it over.
            FilterTags = [];
        }

        // Anonymous, and empty on any install with no LAN bot — in which case the row simply does not
        // render and the shelf looks exactly as it did before this feature existed.
        LanEvents = await LanService.GetEvents();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Re-runs whenever ?q=, ?tags= or ?lan= changes, including navigating back to the unfiltered
        // library.
        //
        // The guard keys off an explicit flag rather than Loading: parameters get set again whenever
        // the cascading auth state resolves or changes (e.g. right after login), and if that landed
        // mid-request the old guard let a *second* concurrent Load start. Two in-flight fetches then
        // raced to assign Games, which is why the shelf sometimes came up empty.
        var key = FilterKey;
        if (hasLoaded && loadedKey == key) return;

        var firstVisit = !hasLoaded;
        hasLoaded = true;
        loadedKey = key;

        // Back from a game: the shelf as it was, scrolled to where it was, with no request at all.
        // Only on arrival - a filter change on this page is a new shelf, not a return to one.
        if (firstVisit && ShelfCache.Take(key) is { } saved)
        {
            Games = saved.Games;
            Next = saved.Next;
            Total = saved.Total;
            Loading = false;
            restoreScrollTo = saved.ScrollY;
            return;
        }

        // A narrower filter is a different, shorter shelf; staying scrolled to where the old one was
        // would leave the reader below the end of it.
        if (!firstVisit && module is not null)
            await module.InvokeVoidAsync("scrollTo", 0);

        await LoadFirst();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                module = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./js/infiniteScroll.js");
                selfRef = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("observe", sentinel, selfRef, "800px 0px");
                observing = true;
            }
            catch (JSException)
            {
                // No observer (or no module): the "Load more" button still works, which is why it
                // exists.
            }
        }

        if (module is null) return;

        if (restoreScrollTo is { } y)
        {
            restoreScrollTo = null;
            await module.InvokeVoidAsync("restoreScroll", y);
        }

        // The observer fires on a CHANGE of intersection. If a batch lands and the sentinel is still
        // within reach - a tall window, or a short batch - nothing would ever change again, and the
        // shelf would stall until the reader nudged it.
        if (recheckAfterRender && observing && Next is not null)
        {
            recheckAfterRender = false;
            await module.InvokeVoidAsync("recheck", sentinel, selfRef);
        }
    }

    /// <summary>
    /// Saves the shelf for the Back button, just before a tile navigates to its game. The anchor
    /// does the navigating; this only records where the reader was.
    /// </summary>
    private void RememberShelf()
    {
        double y = 0;
        try
        {
            if (module is not null) y = module.Invoke<double>("scrollY");
        }
        catch (JSException) { }

        ShelfCache.Save(new ShelfCache.Snapshot(FilterKey, Games, Next, Total, y));
    }

    /// <summary>
    /// Adds or removes a tag from the filter and navigates to the resulting URL.
    ///
    /// The shelf starts over from the top: a narrower filter is a different, shorter list, and the
    /// batches already loaded belong to the old one.
    /// </summary>
    private void ToggleTag(string slug)
    {
        var selected = SelectedTags;
        GoTo(selected.Contains(slug)
            ? selected.Where(s => s != slug).ToList()
            : [.. selected, slug], LanFilter);
    }

    private void ClearTags() => GoTo([], LanFilter);

    /// <summary>
    /// Selects a LAN event, or clears it when the one already on is clicked again — the same toggle
    /// behaviour as a tag chip, except only one event can be on at a time. Two LANs at once is not a
    /// question anybody asks, and an AND across them would almost always return nothing.
    /// </summary>
    private void ToggleLan(string name)
        => GoTo(SelectedTags,
                string.Equals(LanFilter, name, StringComparison.OrdinalIgnoreCase) ? null : name);

    /// <summary>
    /// Navigates to the library with exactly these filters on, keeping any search term.
    ///
    /// Every filter lives in the address, so the back button walks back through them and any state of
    /// this page can be pasted to somebody else.
    /// </summary>
    private void GoTo(List<string> tags, string? lanEvent)
    {
        var parameters = new List<string>();
        if (IsSearching) parameters.Add($"q={Uri.EscapeDataString(Q!)}");
        if (tags.Count > 0) parameters.Add($"tags={Uri.EscapeDataString(string.Join(',', tags))}");

        // Escaped, because event names routinely carry a "#" ("HCP #37 (2026)") which would otherwise
        // truncate the query string at what the browser reads as a fragment.
        if (!string.IsNullOrWhiteSpace(lanEvent)) parameters.Add($"lan={Uri.EscapeDataString(lanEvent)}");

        Navigation.NavigateTo(parameters.Count == 0 ? "/" : "/?" + string.Join('&', parameters));
    }

    /// <summary>Starts the shelf over from the first batch under the current filters.</summary>
    private async Task LoadFirst()
    {
        var mine = BeginGeneration();

        Loading = true;
        LoadingMore = false;
        Error = null;
        MoreError = null;
        Games = [];
        Next = null;
        Total = null;

        try
        {
            var batch = await GamesService.Browse(
                IsSearching ? Q : null, SelectedTags, LanFilter, after: null, BatchSize, inflight!.Token);
            if (mine != generation) return;

            Games = batch.Items;
            Next = batch.Next;
            Total = batch.Total;
            recheckAfterRender = true;
        }
        catch (OperationCanceledException) when (mine != generation)
        {
            return;
        }
        catch (Exception ex)
        {
            if (mine != generation) return;
            Error = $"Could not load the library: {ex.Message}";
        }
        Loading = false;
    }

    /// <summary>
    /// Appends the next batch. Called by the scroll observer, the "Load more" button and Retry.
    ///
    /// Re-entrancy is the normal case, not an edge: the observer can fire again while a batch is in
    /// flight. The LoadingMore check makes that a no-op rather than a second request for the same
    /// cursor, which would append the same games twice.
    /// </summary>
    [JSInvokable]
    public async Task LoadMore()
    {
        if (Loading || LoadingMore || Next is null || !string.IsNullOrEmpty(MoreError)) return;

        var mine = generation;
        var cursor = Next;
        LoadingMore = true;
        StateHasChanged();

        try
        {
            var batch = await GamesService.Browse(
                IsSearching ? Q : null, SelectedTags, LanFilter, cursor, BatchSize,
                inflight?.Token ?? CancellationToken.None);
            if (mine != generation) return;

            Games.AddRange(batch.Items);
            Next = batch.Next;
            recheckAfterRender = true;
        }
        catch (OperationCanceledException) when (mine != generation)
        {
            return;
        }
        catch (Exception ex)
        {
            if (mine != generation) return;
            MoreError = $"Could not load more: {ex.Message}";
        }
        finally
        {
            if (mine == generation) LoadingMore = false;
        }
        StateHasChanged();
    }

    private async Task RetryMore()
    {
        MoreError = null;
        await LoadMore();
    }

    /// <summary>Abandons whatever the previous filters had in flight and returns the new generation.</summary>
    private int BeginGeneration()
    {
        inflight?.Cancel();
        inflight?.Dispose();
        inflight = new CancellationTokenSource();
        return ++generation;
    }

    public async ValueTask DisposeAsync()
    {
        inflight?.Cancel();
        inflight?.Dispose();

        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("unobserve", sentinel);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        selfRef?.Dispose();
    }

    private static string FormatSize(double megabytes)
        => megabytes < 1 ? $"{megabytes * 1024:0.#} KB" : $"{megabytes:0.#} MB";

    /// <summary>
    /// The tooltip behind a tile's suggestion mark. Lists the events rather than a count, because
    /// "suggested for HCP #37 (2026)" answers the question and "suggested 1 time" does not.
    /// </summary>
    private static string SuggestedTitle(GameContract game)
    {
        var events = string.Join(", ", game.SuggestedFor);
        return game.PlayedAtLan ? $"Played at {events}" : $"Suggested for {events}";
    }
}

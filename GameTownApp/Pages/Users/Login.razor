@using GameTownApp.Services;
@page "/login"
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@using GameTownApp.Models;
@using GameTownApp.Models.Auth
<div class="login-container">
    <h3>Login</h3>
    <div class="login-form">
        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <label for="username">Username</label>
                <InputText id="username" @bind-Value="loginModel.Username" class="form-control" />
            </div>
            <div>
                <label for="password">Password</label>
                <InputText id="password" type="password" @bind-Value="loginModel.Password" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
        </EditForm>
        <div class="login_result">
            @LoginMsg
        </div>
    </div>
</div>
@code {
    LoginModel loginModel = new LoginModel();
    private string LoginMsg = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        //try to login without user interaction /credentials via the perhaos set cookies
        var refreshed = await AuthService.RefreshTokenAsync();
        if (refreshed)
        {
            NavigationManager.NavigateTo("/");
        }
    }
    private async Task HandleLogin()
    {
        Console.WriteLine("Login clicked");
        var loginResult = await AuthService.LoginAsync(loginModel);
        if(loginResult)
        {
            NavigationManager.NavigateTo("/");
        }
        LoginMsg = loginResult ? "Login successful!" : "Login failed. Please check your credentials.";
    }

}

@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@inject SettingsService SettingsService

@*
    Deliberately a page inside the SPA rather than a server-rendered Razor Page.

    Server rendering is the right call for the FIRST-RUN wizard, which has to work before the app is
    configured at all. This screen has no such constraint — by the time an admin opens it the app is
    running and configured — so it belongs with the rest of the admin console, sharing its nav, its
    styling and its tab/alert conventions (see UserManagement.razor).
*@

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger alert-dismissible">
        @Error
        <button type="button" class="btn-close" @onclick="() => Error = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Notice))
{
    <div class="alert alert-success alert-dismissible">
        @Notice
        <button type="button" class="btn-close" @onclick="() => Notice = null"></button>
    </div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(Tab == "storage" ? "active" : "")" @onclick='() => Tab = "storage"'>Storage</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Tab == "metadata" ? "active" : "")" @onclick='() => Tab = "metadata"'>Metadata</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Tab == "uploads" ? "active" : "")" @onclick='() => Tab = "uploads"'>Uploads</button>
    </li>
</ul>

@if (Loading)
{
    <p><em>Loading…</em></p>
}
else if (Current is null)
{
    <p class="text-danger">Settings could not be loaded.</p>
}
else if (Tab == "storage")
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Game archives</h5>
            <p class="text-secondary small">
                Where uploaded games are stored. Point this at whichever disk has the room —
                it takes effect immediately, without restarting.
            </p>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Archive directory</label>
                    <input class="form-control" @bind="GameFilesPath" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="CheckPath" disabled="@Busy">Check</button>
                    <button class="btn btn-primary" @onclick="SaveStorage" disabled="@Busy">Save</button>
                </div>
            </div>

            @if (PathCheck is not null)
            {
                <div class="alert @(PathCheck.Writable ? "alert-success" : "alert-warning") mt-3 mb-0">
                    @DescribePathCheck(PathCheck)
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Data directory</h5>
            <p class="text-secondary small mb-2">
                Read-only. Everything here survives an upgrade — the database, the encryption keys
                that keep you signed in, and re-hosted cover art. Never point an installer anywhere
                else.
            </p>
            <dl class="row mb-0">
                <dt class="col-sm-3">Data directory</dt>
                <dd class="col-sm-9"><code>@Current.DataDirectory</code></dd>
                <dt class="col-sm-3">Cover art</dt>
                <dd class="col-sm-9"><code>@Current.MediaDirectory</code></dd>
            </dl>
        </div>
    </div>
}
else if (Tab == "metadata")
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">RAWG</h5>
            <p class="text-secondary small">
                Used to fetch cover art, screenshots and descriptions.
                <strong>Optional</strong> — without a key GameTown works exactly as it does now, you
                just fill metadata in by hand instead of importing it.
            </p>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">
                        API key
                        @if (Current.RawgApiKeyIsSet)
                        {
                            <span class="text-secondary">(currently @Current.RawgApiKeyMasked)</span>
                        }
                    </label>
                    <input class="form-control" type="password" placeholder="@(Current.RawgApiKeyIsSet ? "Leave blank to keep the current key" : "Not set")" @bind="RawgApiKey" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="TestKey" disabled="@Busy">Test key</button>
                    <button class="btn btn-primary" @onclick="SaveRawg" disabled="@Busy">Save</button>
                </div>
            </div>

            @if (Current.RawgApiKeyIsSet)
            {
                <button class="btn btn-link text-danger px-0 mt-2" @onclick="ClearKey" disabled="@Busy">Remove the stored key</button>
            }

            @if (KeyCheck is not null)
            {
                <div class="alert @(KeyCheck.Ok ? "alert-success" : "alert-warning") mt-3 mb-0">
                    @DescribeKeyCheck(KeyCheck)
                </div>
            }
        </div>
    </div>
}
else if (Tab == "uploads")
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Allowed file types</h5>
            <p class="text-secondary small">
                Which archive types contributors may upload. Enforced on the server, so this is a
                real restriction rather than a hint to the file picker.
            </p>

            <div class="mb-3">
                @foreach (var type in AllowedFileTypes)
                {
                    <span class="badge bg-secondary me-2 mb-2">
                        @type
                        <button type="button" class="btn-close btn-close-white ms-2"
                                @onclick="() => RemoveType(type)"></button>
                    </span>
                }
                @if (AllowedFileTypes.Count == 0)
                {
                    <span class="text-danger">None — nothing could be uploaded.</span>
                }
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Add a type</label>
                    <input class="form-control" placeholder=".zip" @bind="NewType" @onkeyup="OnNewTypeKey" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="AddType">Add</button>
                    <button class="btn btn-primary" @onclick="SaveUploads" disabled="@Busy">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string Tab = "storage";
    private bool Loading = true;
    private bool Busy;
    private string? Error;
    private string? Notice;

    private SettingsContract? Current;
    private string GameFilesPath = string.Empty;
    private string RawgApiKey = string.Empty;
    private List<string> AllowedFileTypes = [];
    private string NewType = string.Empty;

    private PathCheckResult? PathCheck;
    private RawgKeyCheckResult? KeyCheck;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        Current = await SettingsService.GetSettings();
        Adopt(Current);
        Loading = false;
    }

    // The server normalises what it stores, so the form always adopts the response rather than
    // keeping what was typed. Otherwise ".ZIP" would keep displaying as ".ZIP" while the server had
    // stored ".zip".
    private void Adopt(SettingsContract? settings)
    {
        if (settings is null) return;
        Current = settings;
        GameFilesPath = settings.GameFilesPath;
        AllowedFileTypes = [.. settings.AllowedFileTypes];
        RawgApiKey = string.Empty;
    }

    private async Task SaveStorage()
        => await Save(new SettingsUpdateRequest { GameFilesPath = GameFilesPath }, "Archive directory saved.");

    private async Task SaveRawg()
    {
        if (string.IsNullOrWhiteSpace(RawgApiKey))
        {
            Error = "Enter a key, or use \"Remove the stored key\" to clear it.";
            return;
        }
        await Save(new SettingsUpdateRequest { RawgApiKey = RawgApiKey }, "RAWG key saved.");
    }

    private async Task ClearKey()
        => await Save(new SettingsUpdateRequest { ClearRawgApiKey = true }, "RAWG key removed.");

    private async Task SaveUploads()
        => await Save(new SettingsUpdateRequest { AllowedFileTypes = AllowedFileTypes }, "Allowed file types saved.");

    private async Task Save(SettingsUpdateRequest request, string success)
    {
        Busy = true;
        Error = null;
        Notice = null;

        var (result, updated) = await SettingsService.UpdateSettings(request);
        if (result.Success)
        {
            Adopt(updated);
            Notice = success;
        }
        else
        {
            Error = result.Error ?? "The change could not be saved.";
        }

        Busy = false;
    }

    private async Task CheckPath()
    {
        Busy = true;
        PathCheck = await SettingsService.CheckPath(GameFilesPath);
        Busy = false;
    }

    private async Task TestKey()
    {
        Busy = true;
        KeyCheck = await SettingsService.TestRawgKey();
        Busy = false;
    }

    private void AddType()
    {
        var candidate = NewType.Trim().ToLowerInvariant();
        if (candidate.Length == 0) return;
        if (!candidate.StartsWith('.')) candidate = "." + candidate;
        if (candidate.Length > 1 && !AllowedFileTypes.Contains(candidate))
        {
            AllowedFileTypes.Add(candidate);
        }
        NewType = string.Empty;
    }

    private void OnNewTypeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddType();
    }

    private void RemoveType(string type) => AllowedFileTypes.Remove(type);

    // Reason codes rather than server text, so nothing about the server's filesystem leaks through
    // an error string. Translating them is the client's job.
    private static string DescribePathCheck(PathCheckResult check) => check.Reason switch
    {
        "ok" when check.FreeBytes is not null
            => $"Usable. {check.FreeBytes / 1024 / 1024 / 1024} GB free.",
        "ok" => "Usable.",
        "not-absolute" => "Enter an absolute path.",
        "permission-denied" => "GameTown does not have permission to write there.",
        "not-found" => "That directory does not exist and could not be created.",
        "io-error" => "That directory could not be written to.",
        _ => "That path is not usable.",
    };

    private static string DescribeKeyCheck(RawgKeyCheckResult check) => check.Reason switch
    {
        "ok" => "RAWG accepted the key.",
        "rejected" => "RAWG rejected the key.",
        "unreachable" => "RAWG could not be reached — check the server's internet connection.",
        "not-configured" => "No key is stored yet.",
        _ => "The key could not be checked.",
    };
}

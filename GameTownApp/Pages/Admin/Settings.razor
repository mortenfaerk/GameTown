@page "/settings"
@attribute [Authorize(Roles = "Admin")]
@inject SettingsService SettingsService

@*
    Deliberately a page inside the SPA rather than a server-rendered Razor Page.

    Server rendering is the right call for the FIRST-RUN wizard, which has to work before the app is
    configured at all. This screen has no such constraint — by the time an admin opens it the app is
    running and configured — so it belongs with the rest of the admin console, sharing its nav, its
    styling and its tab/alert conventions (see UserManagement.razor).
*@

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger alert-dismissible">
        @Error
        <button type="button" class="btn-close" @onclick="() => Error = null"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Notice))
{
    <div class="alert alert-success alert-dismissible">
        @Notice
        <button type="button" class="btn-close" @onclick="() => Notice = null"></button>
    </div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(Tab == "storage" ? "active" : "")" @onclick='() => Tab = "storage"'>Storage</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Tab == "metadata" ? "active" : "")" @onclick='() => Tab = "metadata"'>Metadata</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(Tab == "uploads" ? "active" : "")" @onclick='() => Tab = "uploads"'>Uploads</button>
    </li>
</ul>

@if (Loading)
{
    <p><em>Loading…</em></p>
}
else if (Current is null)
{
    <p class="text-danger">Settings could not be loaded.</p>
}
else if (Tab == "storage")
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Game archives</h5>
            <p class="text-secondary small">
                Where uploaded games are stored. Point this at whichever disk has the room —
                it takes effect immediately, without restarting.
            </p>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Archive directory</label>
                    <input class="form-control" @bind="GameFilesPath" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="CheckPath" disabled="@Busy">Check</button>
                    <button class="btn btn-primary" @onclick="SaveStorage" disabled="@Busy">Save</button>
                </div>
            </div>

            @if (PathCheck is not null)
            {
                <div class="alert @(PathCheck.Writable ? "alert-success" : "alert-warning") mt-3 mb-0">
                    @DescribePathCheck(PathCheck)
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Data directory</h5>
            <p class="text-secondary small mb-2">
                Read-only. Everything here survives an upgrade — the database, the encryption keys
                that keep you signed in, and re-hosted cover art. Never point an installer anywhere
                else.
            </p>
            <dl class="row mb-0">
                <dt class="col-sm-3">Data directory</dt>
                <dd class="col-sm-9"><code>@Current.DataDirectory</code></dd>
                <dt class="col-sm-3">Cover art</dt>
                <dd class="col-sm-9"><code>@Current.MediaDirectory</code></dd>
            </dl>
        </div>
    </div>
}
else if (Tab == "metadata")
{
    @*
        The upgrade banner. Shown only when games are actually still on the retired provider AND no
        IGDB credentials have been entered — that is, on an install that has just taken the upgrade
        and has not been set up yet. An install with nothing to re-link never hears about the swap:
        it is history, not news, and announcing it invites an operator to go looking for a problem
        they do not have.

        Without it the symptom an operator meets is a metadata picker that silently refuses to search,
        with nothing on screen connecting that to a provider that no longer exists. The first sentence
        is the one that matters most: their library is fine.
    *@
    @if (Current.RelinkCandidateCount > 0 && !Current.IgdbCredentialsAreSet)
    {
        <div class="alert alert-info">
            <h6 class="alert-heading">Metadata now comes from IGDB</h6>
            <p class="mb-2">
                RAWG, which this library's existing metadata came from, is no longer available.
                <strong>Your library is unaffected</strong> — every game keeps its description,
                screenshots, genres and artwork, because all of it was downloaded onto this server
                when it was first imported.
            </p>
            <p class="mb-0">
                Adding credentials below restores <em>searching</em> for new games. Once they are in,
                <a href="metadata-relink">Re-link metadata</a> can move existing games over to
                IGDB, a few at a time or all at once — entirely optional, and nothing happens until
                you ask it to.
            </p>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">IGDB</h5>
            <p class="text-secondary small">
                Used to fetch cover art, screenshots and descriptions.
                <strong>Optional</strong> — without credentials GameTown works exactly as it does now,
                you just fill metadata in by hand instead of importing it.
            </p>
            <p class="text-secondary small">
                IGDB has no API key. It authenticates through a <strong>Twitch application</strong>:
                register one at
                <a href="https://dev.twitch.tv/console/apps" target="_blank" rel="noopener">dev.twitch.tv/console/apps</a>
                (the account needs two-factor authentication) and copy the Client ID and Client Secret
                it gives you. The redirect URL it asks for is not used and can be anything.
            </p>

            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Client ID</label>
                    @*
                        Not a password field, and shown in full. The client id is sent as a header on
                        every request and is not a secret — masking it would only stop an admin
                        checking which application this install is pointed at.
                    *@
                    <input class="form-control" type="text"
                           placeholder="@(string.IsNullOrEmpty(Current.IgdbClientId) ? "Not set" : Current.IgdbClientId)"
                           @bind="IgdbClientId" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">
                        Client Secret
                        @if (Current.IgdbClientSecretMasked is not null)
                        {
                            <span class="text-secondary">(currently @Current.IgdbClientSecretMasked)</span>
                        }
                    </label>
                    <input class="form-control" type="password"
                           placeholder="@(Current.IgdbCredentialsAreSet ? "Leave blank to keep the current secret" : "Not set")"
                           @bind="IgdbClientSecret" />
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary" @onclick="SaveIgdb" disabled="@Busy">Save</button>
                <button class="btn btn-outline-secondary" @onclick="TestKey" disabled="@Busy">Test credentials</button>
            </div>

            @if (Current.IgdbCredentialsAreSet || !string.IsNullOrEmpty(Current.IgdbClientId))
            {
                <button class="btn btn-link text-danger px-0 mt-2" @onclick="ClearKey" disabled="@Busy">Remove the stored credentials</button>
            }

            @if (KeyCheck is not null)
            {
                <div class="alert @(KeyCheck.Ok ? "alert-success" : "alert-warning") mt-3 mb-0">
                    @DescribeKeyCheck(KeyCheck, "IGDB")
                </div>
            }
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">SteamGridDB (cover art)</h5>
            <p class="text-secondary small">
                Used to search for the portrait box art games are shelved under. A separate source
                because the cover is a choice: a contributor picking the art a game sits behind on the
                shelf beats whatever the metadata catalogue happens to supply. A free key comes with a
                SteamGridDB account.
                <strong>Optional</strong> — without one, contributors can still upload a cover file or
                paste an image link; only the search is unavailable.
            </p>

            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">
                        API key
                        @if (Current.BoxArtApiKeyIsSet)
                        {
                            <span class="text-secondary">(currently @Current.BoxArtApiKeyMasked)</span>
                        }
                    </label>
                    <input class="form-control" type="password" placeholder="@(Current.BoxArtApiKeyIsSet ? "Leave blank to keep the current key" : "Not set")" @bind="BoxArtApiKey" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="TestBoxArtKey" disabled="@Busy">Test key</button>
                    <button class="btn btn-primary" @onclick="SaveBoxArt" disabled="@Busy">Save</button>
                </div>
            </div>

            @if (Current.BoxArtApiKeyIsSet)
            {
                <button class="btn btn-link text-danger px-0 mt-2" @onclick="ClearBoxArtKey" disabled="@Busy">Remove the stored key</button>
            }

            @if (BoxArtKeyCheck is not null)
            {
                <div class="alert @(BoxArtKeyCheck.Ok ? "alert-success" : "alert-warning") mt-3 mb-0">
                    @DescribeKeyCheck(BoxArtKeyCheck, "SteamGridDB")
                </div>
            }
        </div>
    </div>
}
else if (Tab == "uploads")
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Allowed file types</h5>
            <p class="text-secondary small">
                Which archive types contributors may upload. Enforced on the server, so this is a
                real restriction rather than a hint to the file picker.
            </p>

            <div class="mb-3">
                @foreach (var type in AllowedFileTypes)
                {
                    <span class="badge bg-secondary me-2 mb-2">
                        @type
                        <button type="button" class="btn-close btn-close-white ms-2"
                                @onclick="() => RemoveType(type)"></button>
                    </span>
                }
                @if (AllowedFileTypes.Count == 0)
                {
                    <span class="text-danger">None — nothing could be uploaded.</span>
                }
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Add a type</label>
                    <input class="form-control" placeholder=".zip" @bind="NewType" @onkeyup="OnNewTypeKey" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-secondary" @onclick="AddType">Add</button>
                    <button class="btn btn-primary" @onclick="SaveUploads" disabled="@Busy">Save</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Maximum upload size</h5>
            <p class="text-secondary small">
                The largest archive a contributor may upload. <strong>0 means no limit</strong>, which
                is the default. Enforced against the bytes as they arrive, so a client that
                understates the size of its file is still stopped.
            </p>

            <div class="alert alert-secondary small">
                A reverse proxy in front of GameTown has its own limit, and it wins — it rejects the
                request before GameTown ever sees it. nginx (including Nginx Proxy Manager) defaults
                to <strong>1 MB</strong> and answers with a 413. Set
                <code>client_max_body_size 0;</code> there and let this setting be the real ceiling.
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="max-upload-size">Maximum size (MB)</label>
                    <input id="max-upload-size" type="number" min="0" step="1" class="form-control"
                           @bind="MaxUploadSizeMb" />
                </div>
                <div class="col-md-4">
                    <button class="btn btn-primary" @onclick="SaveMaxUploadSize" disabled="@Busy">Save</button>
                </div>
            </div>

            <p class="text-secondary small mt-2 mb-0">
                @(MaxUploadSizeMb <= 0
                    ? "Currently unlimited."
                    : $"Currently {MaxUploadSizeMb} MB.")
            </p>
        </div>
    </div>
}

@code {
    private string Tab = "storage";
    private bool Loading = true;
    private bool Busy;
    private string? Error;
    private string? Notice;

    private SettingsContract? Current;
    private string GameFilesPath = string.Empty;
    private string IgdbClientId = string.Empty;
    private string IgdbClientSecret = string.Empty;
    private string BoxArtApiKey = string.Empty;
    private List<string> AllowedFileTypes = [];
    private string NewType = string.Empty;
    private long MaxUploadSizeMb;

    private PathCheckResult? PathCheck;
    private ProviderCredentialCheckResult? KeyCheck;
    private ProviderCredentialCheckResult? BoxArtKeyCheck;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        Loading = true;
        Current = await SettingsService.GetSettings();
        Adopt(Current);
        Loading = false;
    }

    // The server normalises what it stores, so the form always adopts the response rather than
    // keeping what was typed. Otherwise ".ZIP" would keep displaying as ".ZIP" while the server had
    // stored ".zip".
    private void Adopt(SettingsContract? settings)
    {
        if (settings is null) return;
        Current = settings;
        GameFilesPath = settings.GameFilesPath;
        AllowedFileTypes = [.. settings.AllowedFileTypes];
        MaxUploadSizeMb = settings.MaxUploadSizeMb;
        // The secret boxes are emptied rather than repopulated: the browser is never given a stored
        // secret, so there is nothing to put back, and a blank box is what "unchanged" looks like.
        // The client id is NOT a secret and is shown as the field's placeholder, so it needs no
        // special handling here.
        IgdbClientId = string.Empty;
        IgdbClientSecret = string.Empty;
        BoxArtApiKey = string.Empty;
    }

    private async Task SaveStorage()
        => await Save(new SettingsUpdateRequest { GameFilesPath = GameFilesPath }, "Archive directory saved.");

    private async Task SaveIgdb()
    {
        if (string.IsNullOrWhiteSpace(IgdbClientId) && string.IsNullOrWhiteSpace(IgdbClientSecret))
        {
            Error = "Enter a Client ID and Client Secret, or use \"Remove the stored credentials\" to clear them.";
            return;
        }

        // Requiring both on a FIRST save, but not on a later one. Saving a secret alone is how an
        // admin rotates it after regenerating it in the Twitch console — the client id does not
        // change — while saving an id alone before either exists just leaves the install
        // half-configured and reporting itself as unset.
        if (!Current!.IgdbCredentialsAreSet
            && (string.IsNullOrWhiteSpace(IgdbClientId) || string.IsNullOrWhiteSpace(IgdbClientSecret)))
        {
            Error = "Both the Client ID and the Client Secret are needed.";
            return;
        }

        await Save(
            new SettingsUpdateRequest { IgdbClientId = IgdbClientId, IgdbClientSecret = IgdbClientSecret },
            "IGDB credentials saved.");
    }

    private async Task ClearKey()
        => await Save(new SettingsUpdateRequest { ClearIgdbCredentials = true }, "IGDB credentials removed.");

    private async Task SaveBoxArt()
    {
        if (string.IsNullOrWhiteSpace(BoxArtApiKey))
        {
            Error = "Enter a key, or use \"Remove the stored key\" to clear it.";
            return;
        }
        await Save(new SettingsUpdateRequest { BoxArtApiKey = BoxArtApiKey }, "Cover art key saved.");
    }

    private async Task ClearBoxArtKey()
        => await Save(new SettingsUpdateRequest { ClearBoxArtApiKey = true }, "Cover art key removed.");

    private async Task SaveUploads()
        => await Save(new SettingsUpdateRequest { AllowedFileTypes = AllowedFileTypes }, "Allowed file types saved.");

    private async Task SaveMaxUploadSize()
    {
        if (MaxUploadSizeMb < 0)
        {
            Error = "Enter 0 for no limit, or a positive number of megabytes.";
            return;
        }

        await Save(new SettingsUpdateRequest { MaxUploadSizeMb = MaxUploadSizeMb },
            MaxUploadSizeMb == 0 ? "Upload size limit removed." : $"Upload size limit set to {MaxUploadSizeMb} MB.");
    }

    private async Task Save(SettingsUpdateRequest request, string success)
    {
        Busy = true;
        Error = null;
        Notice = null;

        var (result, updated) = await SettingsService.UpdateSettings(request);
        if (result.Success)
        {
            Adopt(updated);
            Notice = success;
        }
        else
        {
            Error = result.Error ?? "The change could not be saved.";
        }

        Busy = false;
    }

    private async Task CheckPath()
    {
        Busy = true;
        PathCheck = await SettingsService.CheckPath(GameFilesPath);
        Busy = false;
    }

    private async Task TestKey()
    {
        Busy = true;
        KeyCheck = await SettingsService.TestIgdbCredentials();
        Busy = false;
    }

    private async Task TestBoxArtKey()
    {
        Busy = true;
        BoxArtKeyCheck = await SettingsService.TestBoxArtKey();
        Busy = false;
    }

    private void AddType()
    {
        var candidate = NewType.Trim().ToLowerInvariant();
        if (candidate.Length == 0) return;
        if (!candidate.StartsWith('.')) candidate = "." + candidate;
        if (candidate.Length > 1 && !AllowedFileTypes.Contains(candidate))
        {
            AllowedFileTypes.Add(candidate);
        }
        NewType = string.Empty;
    }

    private void OnNewTypeKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddType();
    }

    private void RemoveType(string type) => AllowedFileTypes.Remove(type);

    // Reason codes rather than server text, so nothing about the server's filesystem leaks through
    // an error string. Translating them is the client's job.
    private static string DescribePathCheck(PathCheckResult check) => check.Reason switch
    {
        // The filesystem name is worth showing even on success: it is how an operator sees that the
        // network share they meant to use is not actually mounted. An unmounted mountpoint is
        // writable, has free space, and is the local disk.
        "ok" when check.FreeBytes is not null && check.FileSystem is not null
            => $"Usable. {check.FreeBytes / 1024 / 1024 / 1024} GB free on {check.FileSystem}.",
        "ok" when check.FreeBytes is not null
            => $"Usable. {check.FreeBytes / 1024 / 1024 / 1024} GB free.",
        "ok" => "Usable.",
        "not-absolute" => "Enter an absolute path.",
        "unc-not-supported"
            => "GameTown cannot open a network share directly — it runs unprivileged and cannot mount one. "
             + "Mount the share on the server (smb-mount.sh does this) and enter the mountpoint instead.",
        "permission-denied" => "GameTown does not have permission to write there.",
        "not-found" => "That directory does not exist and could not be created.",
        "io-error" => "That directory could not be written to.",
        _ => "That path is not usable.",
    };

    /// <summary>
    /// Both credential tests answer in the same reason codes, so they share the wording — only the
    /// provider's name changes. "no-match" is a SteamGridDB-only outcome and counts as working: the key
    /// was accepted and the provider answered, it simply had no art for the title used as the probe.
    ///
    /// "rate-limited" is IGDB-only and also counts as reaching the provider, which is why it says so
    /// rather than being folded into the generic failure — credentials that work but are momentarily
    /// throttled must not read as credentials that are wrong.
    /// </summary>
    private static string DescribeKeyCheck(ProviderCredentialCheckResult check, string provider) => check.Reason switch
    {
        "ok" => $"{provider} accepted the credentials.",
        "no-match" => $"{provider} accepted the credentials.",
        "rejected" => $"{provider} rejected the credentials.",
        "rate-limited" => $"{provider} accepted the credentials but is rate-limiting us. Try again in a moment.",
        "unreachable" => $"{provider} could not be reached — check the server's internet connection.",
        "not-configured" => "Nothing is stored yet.",
        _ => "The credentials could not be checked.",
    };
}

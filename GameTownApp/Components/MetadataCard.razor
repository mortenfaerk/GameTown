@inject GamesService GamesService

@*
    One provider record, shown in full.

    The facts are set as a labelled grid rather than a list of sentences: they are fields of a
    catalogue entry, and a reader scans them for the one they came for. The description is clamped
    because an IGDB summary runs long enough to become the page, and wherever this card appears it is
    context rather than the content.

    Images go through ResolveMedia: a record fetched live from the provider carries absolute CDN URLs
    (passed through untouched), while anything already stored is a /media path that has to be resolved
    against the API rather than this app.
*@

@if (Game is not null)
{
    <div class="gt-card">
        <div class="gt-card__art">
            @if (!string.IsNullOrEmpty(Game.Image))
            {
                <img src="@GamesService.ResolveMedia(Game.Image)" alt="@($"Cover art for {Game.Name}")" />
            }
            else
            {
                <div class="tile__fallback">@GamesService.InitialsFor(Game.Name)</div>
            }
        </div>

        <div class="gt-card__body">
            <h4 class="gt-card__title">@Game.Name</h4>

            <dl class="gt-card__facts">
                <div>
                    <dt class="gt-eyebrow">Released</dt>
                    <dd>@(Game.Released?.ToString("yyyy-MM-dd") ?? "—")</dd>
                </div>
                <div>
                    @*
                        "Critic score", not "Metacritic". On a row carried over from RAWG it IS a
                        Metacritic score; on anything fetched since it is IGDB's own aggregate.
                        Labelling both as Metacritic would be a small lie that gets believed.
                    *@
                    <dt class="gt-eyebrow">Critic score</dt>
                    <dd>@(Game.CriticScore is null ? "—" : Math.Round(Game.CriticScore.Value).ToString("0"))</dd>
                </div>
                <div>
                    <dt class="gt-eyebrow">Rating</dt>
                    <dd>@(Game.Rating?.ToString("0.0") ?? "—")</dd>
                </div>
                @* Lists, not values: given a column each they wrap one studio per line. *@
                <div class="is-wide">
                    <dt class="gt-eyebrow">Genres</dt>
                    <dd>@(Game.Genres.Count == 0 ? "—" : string.Join(", ", Game.Genres.Select(g => g.Name)))</dd>
                </div>
                <div class="is-wide">
                    <dt class="gt-eyebrow">Developers</dt>
                    <dd>@(Game.Developers.Count == 0 ? "—" : string.Join(", ", Game.Developers.Select(d => d.Name)))</dd>
                </div>
            </dl>

            @if (!string.IsNullOrEmpty(Game.Description))
            {
                <div class="gt-card__blurb @(expanded ? null : "is-clamped")">@((MarkupString)Game.Description)</div>

                @if (IsLong)
                {
                    <button type="button" class="btn btn-sm btn-link p-0 mt-1"
                            @onclick="() => expanded = !expanded">
                        @(expanded ? "Show less" : "Show more")
                    </button>
                }
            }

            @if (!string.IsNullOrEmpty(Game.Website))
            {
                <div class="mt-3">
                    <a href="@Game.Website" class="btn btn-sm btn-outline-secondary" target="_blank" rel="noopener">
                        More about this game
                    </a>
                </div>
            }
        </div>
    </div>

    @if (ShowScreenshots && Game.Screenshots.Count > 0)
    {
        <div class="shots mt-3 mb-4">
            @foreach (var shot in Game.Screenshots.Where(s => !s.IsDeleted))
            {
                <img src="@GamesService.ResolveMedia(shot.Image)" alt="Screenshot of @Game.Name" loading="lazy" />
            }
        </div>
    }
}

@code {
    [Parameter] public GameMetadataContract? Game { get; set; }
    [Parameter] public bool ShowScreenshots { get; set; }

    private bool expanded;

    /// <summary>
    /// Whether the clamp is doing anything, decided from the raw length.
    ///
    /// Measuring the rendered height would be exact and needs JS; this is a threshold that is wrong
    /// only about a description sitting within a line or two of five, where the button appears and
    /// reveals almost nothing. Cheap to be wrong about.
    /// </summary>
    private bool IsLong => (Game?.Description?.Length ?? 0) > 420;

    protected override void OnParametersSet()
    {
        // A different game gets a fresh clamp: leaving it expanded would apply one record's decision
        // to the next one.
        if (!ReferenceEquals(shown, Game))
        {
            shown = Game;
            expanded = false;
        }
    }

    private GameMetadataContract? shown;
}

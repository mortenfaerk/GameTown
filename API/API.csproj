<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>cef896ee-c3d7-4d63-8ca4-0bf9d8687e28</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Schema migrations ship inside the assembly rather than as loose files, so they cannot go
         missing from a self-contained publish or be edited on a running install. SchemaMigrator
         reads them as embedded resources and keys off the NNN_ prefix. -->
    <EmbeddedResource Include="..\Database\sqlite\migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- Serves the Blazor WASM client from this project so both are one origin: it maps the
         _framework/ assets and the Brotli-compressed bundle that UseBlazorFrameworkFiles needs. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0, which has a high-severity
         advisory (GHSA-v5pm-xwqc-g5wc). Pin the latest 2.x; 3.x is a breaking API change. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Sanitises RAWG-supplied HTML descriptions before they reach the Blazor client, which
         renders them with MarkupString (Blazor's dangerouslySetInnerHTML equivalent). -->
    <PackageReference Include="HtmlSanitizer" Version="9.0.967" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aspire\Aspire.ServiceDefaults\Aspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\EFModel\EFModel.csproj" />
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <!-- The SPA is published INTO this project's wwwroot. One origin means no CORS, a normal
         SameSite=Lax cookie instead of SameSite=None, and one artifact that runs on any LAN
         without a recompile. -->
    <ProjectReference Include="..\GameTownApp\GameTownApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Users\" />
    <Folder Include="wwwroot\media\" />
  </ItemGroup>

</Project>
